{
  "name": "inertia-adapter-solid",
  "version": "1.0.0-beta.9",
  "license": "MIT",
  "description": "The SolidJS adapter for Inertia.js",
  "contributors": [
    "Jorge González <yo@jorgeglz.io>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iksaku/inertia-adapter-solid.git"
  },
  "bugs": {
    "url": "https://github.com/iksaku/inertia-adapter-solid/issues"
  },
  "files": [
    "dist",
    "types",
    "resources"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "types/server.d.ts"
      ],
      "vite": [
        "types/vite.d.ts"
      ]
    }
  },
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "./build.js",
    "postbuild": "tsc",
    "build:with-deps": "pnpm build --with-deps",
    "clean": "rm -rf dist types",
    "dev": "pnpx concurrently -c \"#ffcf00,#3178c6\" \"pnpm dev:build\" \"pnpm dev:types\" --names build,types",
    "dev:build": "./build.js --watch",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "es2022-check": "pnpm build:with-deps && es-check es2022 \"dist/index.js\" --checkFeatures --module --noCache --verbose",
    "prepublish": "pnpm run build",
    "test": "pnpm build && node tests/run.mjs",
    "test:browser": "playwright test --project=chromium",
    "test:browser:all": "playwright test",
    "test:browser:axios": "VITE_HTTP_CLIENT=axios playwright test --project=chromium",
    "test:ssr": "SSR=true playwright test --project=chromium",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:fixtures:types": "tsc --noEmit -p tests/test-app/tsconfig.json",
    "test:app:build": "vite build --config tests/test-app/vite.config.ts",
    "test:app:ssr": "vite build --config tests/test-app/vite.config.ts --ssr ssr.tsx --outDir dist",
    "test:app:ssr:auto": "vite build --config tests/test-app/vite.config.ts --ssr ssr-auto.tsx --outDir dist"
  },
  "dependencies": {
    "@inertiajs/core": "^3.9.1",
    "@solid-primitives/deep": "^0.3.7",
    "@solid-primitives/memo": "^1.5.1",
    "es-toolkit": "^1.47.1",
    "laravel-precognition": "^2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.0",
    "@inertiajs/vite": "^3.9.1",
    "@playwright/test": "1.58.2",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "es-check": "^9.6.4",
    "esbuild": "^0.28.1",
    "esbuild-node-externals": "^1.23.1",
    "express": "^5.3.0",
    "jsdom": "^30.1.2",
    "multer": "^2.4.0",
    "solid-js": "^1.9.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@solidjs/meta": "^0.29.4",
    "solid-js": "^1.9.17"
  }
}
